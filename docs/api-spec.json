      ]
    },
    "audio": {
      "description": "오디오 관련 API (Public)",
      "routes": [
        {
          "method": "GET",
          "path": "/api/audio/:filename",
          "description": "오디오 파일 조회",
          "auth": false,
          "params": {
            "filename": { "type": "string", "required": true }
          },
          "response": {
            "type": "audio/mpeg",
            "description": "MP3 오디오 파일"
          }
        }
      ]
    }
  },
  "errorCodes": {
    "400": "Bad Request - 잘못된 요청",
    "401": "Unauthorized - 인증 필요",
    "403": "Forbidden - 접근 권한 없음",
    "404": "Not Found - 리소스 없음",
    "500": "Internal Server Error - 서버 오류"
  },
  "commonResponse": {
    "success": {
      "success": true,
      "data": "..."
    },
    "error": {
      "success": false,
      "error": "에러 메시지"
    },
    "paginated": {
      "success": true,
      "data": [],
      "page": 1,
      "per_page": 20,
      "total": 100
    }
  }
}
