{
  "info": {
    "title": "JPTAKU API",
    "version": "1.0.0",
    "description": "일본어 학습 앱 백엔드 API",
    "baseUrl": "http://localhost:8080"
  },
  "auth": {
    "type": "Bearer",
    "header": "Authorization",
    "format": "Bearer {access_token}"
  },
  "endpoints": {
    "auth": {
      "description": "인증 관련 API (Public)",
      "routes": [
        {
          "method": "GET",
          "path": "/api/auth/google",
          "description": "Google OAuth URL 생성",
          "auth": false,
          "query": {
            "state": {
              "type": "string",
              "required": false,
              "default": "default",
              "description": "OAuth state (mobile/web)"
            }
          },
          "response": {
            "success": true,
            "data": {
              "url": "https://accounts.google.com/o/oauth2/..."
            }
          }
        },
        {
          "method": "GET",
          "path": "/api/auth/google/callback",
          "description": "Google OAuth 콜백",
          "auth": false,
          "query": {
            "code": { "type": "string", "required": true },
            "state": { "type": "string", "required": false }
          },
          "response": {
            "success": true,
            "data": {
              "access_token": "eyJhbGciOiJIUzI1NiIs...",
              "refresh_token": "eyJhbGciOiJIUzI1NiIs...",
              "user": {
                "id": 1,
                "email": "user@example.com",
                "name": "사용자",
                "profile_image": "https://..."
              }
            }
          }
        },
        {
          "method": "POST",
          "path": "/api/auth/refresh",
          "description": "토큰 갱신",
          "auth": false,
          "request": {
            "refresh_token": { "type": "string", "required": true }
          },
          "response": {
            "success": true,
            "data": {
              "access_token": "eyJhbGciOiJIUzI1NiIs...",
              "refresh_token": "eyJhbGciOiJIUzI1NiIs..."
            }
          }
        },
        {
          "method": "POST",
          "path": "/api/auth/logout",
          "description": "로그아웃",
          "auth": false,
          "response": {
            "success": true,
            "data": null
          }
        }
      ]
    },
    "user": {
      "description": "사용자 관련 API (Protected)",
      "routes": [
        {
          "method": "GET",
          "path": "/api/user/me",
          "description": "내 정보 조회",
          "auth": true,
          "response": {
            "success": true,
            "data": {
              "id": 1,
              "email": "user@example.com",
              "name": "사용자",
              "profile_image": "https://...",
              "created_at": "2025-01-01T00:00:00Z",
              "onboarding": {
                "categories": ["anime", "game"],
                "level": "beginner"
              },
              "settings": {
                "notification_enabled": true,
                "daily_reminder_time": "09:00",
                "preferred_voice_speed": 1.0,
                "show_romaji": true,
                "show_translation": true
              }
            }
          }
        },
        {
          "method": "PUT",
          "path": "/api/user/profile",
          "description": "프로필 수정",
          "auth": true,
          "request": {
            "name": { "type": "string", "required": false }
          },
          "response": {
            "success": true,
            "data": {
              "id": 1,
              "name": "새이름"
            }
          }
        },
        {
          "method": "POST",
          "path": "/api/user/onboarding",
          "description": "온보딩 정보 저장",
          "auth": true,
          "request": {
            "categories": {
              "type": "array",
              "items": "string",
              "required": true,
              "example": ["anime", "game", "music", "event"]
            },
            "level": {
              "type": "string",
              "required": true,
              "enum": ["beginner", "intermediate", "advanced"],
              "example": "beginner"
            }
          },
          "response": {
            "success": true,
            "data": {
              "id": 1,
              "user_id": 1,
              "categories": ["anime", "game"],
              "level": "beginner"
            }
          }
        },
        {
          "method": "GET",
          "path": "/api/user/settings",
          "description": "설정 조회",
          "auth": true,
          "response": {
            "success": true,
            "data": {
              "notification_enabled": true,
              "daily_reminder_time": "09:00",
              "preferred_voice_speed": 1.0,
              "show_romaji": true,
              "show_translation": true
            }
          }
        },
        {
          "method": "PUT",
          "path": "/api/user/settings",
          "description": "설정 수정",
          "auth": true,
          "request": {
            "notification_enabled": { "type": "boolean", "required": false },
            "daily_reminder_time": { "type": "string", "required": false },
            "preferred_voice_speed": { "type": "number", "required": false },
            "show_romaji": { "type": "boolean", "required": false },
            "show_translation": { "type": "boolean", "required": false }
          },
          "response": {
            "success": true,
            "data": {
              "notification_enabled": true,
              "daily_reminder_time": "09:00",
              "preferred_voice_speed": 1.0,
              "show_romaji": true,
              "show_translation": true
            }
          }
        }
      ]
    },
    "sentences": {
      "description": "문장 관련 API (Protected)",
      "routes": [
        {
          "method": "GET",
          "path": "/api/sentences/today",
          "description": "오늘의 5문장 조회",
          "auth": true,
          "response": {
            "success": true,
            "data": {
              "daily_set_id": 1,
              "date": "2025-01-05",
              "sentences": [
                {
                  "id": 1,
                  "sentence_key": "anime_001",
                  "jp": "今日はいい天気ですね",
                  "kr": "오늘 날씨가 좋네요",
                  "romaji": "kyou wa ii tenki desu ne",
                  "level": "beginner",
                  "category": "anime",
                  "audio_url": "https://storage.example.com/audio/1.mp3",
                  "detail": {
                    "words": [
                      {
                        "japanese": "今日",
                        "reading": "きょう",
                        "meaning": "오늘",
                        "part_of_speech": "명사"
                      }
                    ],
                    "grammar": "~ですね는 동의를 구하는 표현입니다.",
                    "examples": "明日もいい天気だといいですね。"
                  },
                  "quiz": {
                    "fill_blank": {
                      "question_jp": "今日は___天気ですね",
                      "options": ["いい", "わるい", "あつい", "さむい"],
                      "answer": "いい"
                    },
                    "ordering": {
                      "fragments": ["今日は", "いい", "天気", "ですね"],
                      "correct_order": [0, 1, 2, 3]
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "method": "GET",
          "path": "/api/sentences/history",
          "description": "학습 히스토리 조회",
          "auth": true,
          "query": {
            "page": { "type": "integer", "default": 1 },
            "per_page": { "type": "integer", "default": 10, "max": 50 }
          },
          "response": {
            "success": true,
            "data": [],
            "page": 1,
            "per_page": 10,
            "total": 100
          }
        }
      ]
    },
    "learning": {
      "description": "학습 진행 API (Protected)",
      "routes": [
        {
          "method": "GET",
          "path": "/api/learning/today",
          "description": "오늘의 학습 진행 상황 조회",
          "auth": true,
          "query": {
            "daily_set_id": { "type": "integer", "required": true }
          },
          "response": {
            "success": true,
            "data": {
              "daily_set_id": 1,
              "total_sentences": 5,
              "completed_sentences": 3,
              "progress_percentage": 60,
              "sentences": [
                {
                  "sentence_id": 1,
                  "understand": true,
                  "speak": true,
                  "confirm": false,
                  "memorized": false,
                  "quiz_completed": false
                }
              ]
            }
          }
        },
        {
          "method": "POST",
          "path": "/api/learning/progress",
          "description": "학습 진행 상황 업데이트",
          "auth": true,
          "request": {
            "sentence_id": { "type": "integer", "required": true },
            "daily_set_id": { "type": "integer", "required": true },
            "understand": { "type": "boolean", "required": false },
            "speak": { "type": "boolean", "required": false },
            "confirm": { "type": "boolean", "required": false },
            "memorized": { "type": "boolean", "required": false }
          },
          "response": {
            "success": true,
            "data": {
              "id": 1,
              "sentence_id": 1,
              "daily_set_id": 1,
              "understand": true,
              "speak": true,
              "confirm": true,
              "memorized": false
            }
          }
        },
        {
          "method": "POST",
          "path": "/api/learning/quiz",
          "description": "퀴즈 답안 제출",
          "auth": true,
          "request": {
            "sentence_id": { "type": "integer", "required": true },
            "daily_set_id": { "type": "integer", "required": true },
            "fill_blank_answer": { "type": "string", "required": false },
            "ordering_answer": { "type": "array", "items": "integer", "required": false }
          },
          "response": {
            "success": true,
            "data": {
              "sentence_id": 1,
              "fill_blank_correct": true,
              "ordering_correct": true,
              "all_correct": true,
              "memorized": true
            }
          }
        },
        {
          "method": "GET",
          "path": "/api/learning/history",
          "description": "학습 히스토리 조회",
          "auth": true,
          "query": {
            "page": { "type": "integer", "default": 1 },
            "per_page": { "type": "integer", "default": 20 }
          },
          "response": {
            "success": true,
            "data": [],
            "page": 1,
            "per_page": 20,
            "total": 0
          }
        }
      ]
    },
    "flash": {
      "description": "플래시 카드 API (Protected)",
      "routes": [
        {
          "method": "GET",
          "path": "/api/flash/today",
          "description": "오늘의 플래시 카드 조회 (SRS 기반)",
          "auth": true,
          "response": {
            "success": true,
            "data": {
              "sentences": [
                {
                  "id": 1,
                  "jp": "今日はいい天気ですね",
                  "kr": "오늘 날씨가 좋네요",
                  "romaji": "kyou wa ii tenki desu ne",
                  "phrase": "いい天気",
                  "tip": "날씨를 표현할 때 사용하는 기본 표현",
                  "alt": "今日は天気がいいですね",
                  "flash_grade": "mid",
                  "flash_count": 3,
                  "next_review_at": "2025-01-05T14:00:00Z"
                }
              ],
              "total_count": 5,
              "review_count": 3
            }
          }
        },
        {
          "method": "POST",
          "path": "/api/flash/progress",
          "description": "플래시 카드 진행 업데이트 (SRS)",
          "auth": true,
          "request": {
            "sentence_id": { "type": "integer", "required": true },
            "grade": {
              "type": "string",
              "required": true,
              "enum": ["bad", "mid", "good"],
              "description": "bad=10분 후, mid=1시간 후, good=24시간 후(오늘 끝)"
            }
          },
          "response": {
            "success": true,
            "data": {
              "sentence_id": 1,
              "flash_grade": "good",
              "flash_count": 4,
              "next_review_at": "2025-01-06T00:00:00Z"
            }
          }
        }
      ]
    },
    "chat": {
      "description": "AI 대화 API (Protected, SSE 지원)",
      "routes": [
        {
          "method": "POST",
          "path": "/api/chat/session",
          "description": "대화 세션 생성",
          "auth": true,
          "request": {
            "topic": {
              "type": "string",
              "required": true,
              "example": "anime",
              "description": "대화 주제 (anime, game, music, event)"
            },
            "topic_detail": {
              "type": "string",
              "required": true,
              "example": "원피스에 대해서 대화하기",
              "description": "세부 주제 설명"
            }
          },
          "response": {
            "success": true,
            "data": {
              "id": 1,
              "user_id": 1,
              "topic": "anime",
              "topic_detail": "원피스에 대해서 대화하기",
              "current_turn": 0,
              "max_turn": 8,
              "status": "active",
              "started_at": "2025-01-05T10:00:00Z",
              "messages": []
            }
          }
        },
        {
          "method": "GET",
          "path": "/api/chat/session/:id",
          "description": "대화 세션 조회 (메시지 포함)",
          "auth": true,
          "params": {
            "id": { "type": "integer", "required": true, "description": "세션 ID" }
          },
          "response": {
            "success": true,
            "data": {
              "id": 1,
              "user_id": 1,
              "topic": "anime",
              "topic_detail": "원피스에 대해서 대화하기",
              "current_turn": 3,
              "max_turn": 8,
              "status": "active",
              "started_at": "2025-01-05T10:00:00Z",
              "messages": [
                {
                  "id": 1,
                  "session_id": 1,
                  "role": "user",
                  "content": "こんにちは！",
                  "created_at": "2025-01-05T10:00:01Z"
                },
                {
                  "id": 2,
                  "session_id": 1,
                  "role": "assistant",
                  "content": "こんにちは！今日は何について話しましょうか？",
                  "created_at": "2025-01-05T10:00:02Z"
                }
              ]
            }
          }
        },
        {
          "method": "POST",
          "path": "/api/chat/session/:id/end",
          "description": "대화 세션 수동 종료",
          "auth": true,
          "params": {
            "id": { "type": "integer", "required": true }
          },
          "response": {
            "success": true,
            "data": {
              "id": 1,
              "status": "ended",
              "ended_at": "2025-01-05T10:30:00Z",
              "duration_seconds": 1800
            }
          }
        },
        {
          "method": "GET",
          "path": "/api/chat/sessions",
          "description": "대화 세션 목록 조회",
          "auth": true,
          "query": {
            "page": { "type": "integer", "default": 1 },
            "per_page": { "type": "integer", "default": 20 }
          },
          "response": {
            "success": true,
            "data": [],
            "page": 1,
            "per_page": 20,
            "total": 0
          }
        },
        {
          "method": "POST",
          "path": "/api/chat/session/:id/message",
          "description": "메시지 전송 (SSE 스트리밍 응답)",
          "auth": true,
          "params": {
            "id": { "type": "integer", "required": true }
          },
          "request": {
            "message": {
              "type": "string",
              "required": true,
              "example": "こんにちは！",
              "description": "유저가 보내는 메시지 (일본어)"
            }
          },
          "response": {
            "type": "SSE",
            "contentType": "text/event-stream",
            "description": "Server-Sent Events로 실시간 스트리밍",
            "events": [
              {
                "event": "message",
                "data": {
                  "type": "content",
                  "content": "こ"
                },
                "description": "AI 응답 텍스트 청크 (토큰 단위)"
              },
              {
                "event": "message",
                "data": {
                  "type": "done",
                  "content": "{\"current_turn\":1,\"max_turn\":8,\"is_completed\":false}"
                },
                "description": "스트리밍 완료"
              },
              {
                "event": "message",
                "data": {
                  "type": "error",
                  "error": "에러 메시지"
                },
                "description": "에러 발생"
              },
              {
                "event": "close",
                "data": "connection closed",
                "description": "연결 종료"
              }
            ],
            "example": "event: message\ndata: {\"type\":\"content\",\"content\":\"こ\"}\n\nevent: message\ndata: {\"type\":\"content\",\"content\":\"ん\"}\n\nevent: message\ndata: {\"type\":\"content\",\"content\":\"に\"}\n\nevent: message\ndata: {\"type\":\"content\",\"content\":\"ち\"}\n\nevent: message\ndata: {\"type\":\"content\",\"content\":\"は\"}\n\nevent: message\ndata: {\"type\":\"done\",\"content\":\"{\\\"current_turn\\\":1,\\\"max_turn\\\":8,\\\"is_completed\\\":false}\"}\n\nevent: close\ndata: connection closed"
          },
          "notes": [
            "최대 8턴까지 대화 가능 (current_turn >= max_turn이면 자동 종료)",
            "8턴째에는 AI가 자동으로 대화를 마무리하고 피드백 제공",
            "is_completed가 true면 세션이 완료됨"
          ]
        }
      ]
    },
    "feedback": {
      "description": "피드백 및 통계 API (Protected)",
      "routes": [
        {
          "method": "GET",
          "path": "/api/feedback/:sessionId",
          "description": "대화 피드백 조회",
          "auth": true,
          "params": {
            "sessionId": { "type": "integer", "required": true }
          },
          "response": {
            "success": true,
