{
  "openapi": "3.0.0",
  "info": {
    "title": "JPTaku API",
    "version": "1.0.0",
    "description": "일본어 학습 앱 API 명세서"
  },
  "servers": [
    {
      "url": "http://localhost:30001",
      "description": "로컬 개발 서버"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "헬스 체크",
        "description": "서버 상태 확인",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "서버 정상",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "message": { "type": "string", "example": "jptaku API server is running" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/google": {
      "get": {
        "summary": "Google OAuth 로그인 URL 생성",
        "description": "Google 로그인을 위한 인증 URL을 반환",
        "tags": ["Auth"],
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "description": "State 파라미터 (mobile: 모바일 앱으로 리다이렉트)",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/google/callback": {
      "get": {
        "summary": "Google OAuth 콜백",
        "description": "Google 로그인 후 콜백 처리. 모바일 앱인 경우 딥링크로 리다이렉트",
        "tags": ["Auth"],
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "description": "Google Authorization code",
            "schema": { "type": "string" }
          },
          {
            "name": "state",
            "in": "query",
            "description": "State 파라미터 (mobile: 모바일 앱으로 리다이렉트)",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "성공 (웹)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenResponse" }
              }
            }
          },
          "302": {
            "description": "리다이렉트 (모바일)"
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "summary": "토큰 갱신",
        "description": "Refresh Token으로 Access Token 갱신",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refresh_token"],
                "properties": {
                  "refresh_token": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenResponse" }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "로그아웃",
        "description": "로그아웃 (클라이언트에서 토큰 삭제)",
        "tags": ["Auth"],
        "responses": {
          "200": {
            "description": "성공"
          }
        }
      }
    },
    "/api/user/me": {
      "get": {
        "summary": "내 정보 조회",
        "description": "현재 로그인한 유저의 정보 조회",
        "tags": ["User"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          }
        }
      }
    },
    "/api/user/profile": {
      "put": {
        "summary": "프로필 수정",
        "description": "유저 프로필 정보 수정",
        "tags": ["User"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          }
        }
      }
    },
    "/api/user/onboarding": {
      "post": {
        "summary": "온보딩 정보 저장",
        "description": "유저 온보딩 정보 저장 (레벨, 관심사)",
        "tags": ["User"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["categories", "level"],
                "properties": {
                  "categories": {
                    "type": "array",
                    "items": { "type": "integer" },
                    "description": "카테고리 코드 배열 (1: 애니, 2: 게임, 3: 음악, 4: 영화, 5: 드라마)"
                  },
                  "level": {
                    "type": "integer",
                    "description": "레벨 (3: N3, 4: N4, 5: N5)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공"
          }
        }
      }
    },
    "/api/user/settings": {
      "get": {
        "summary": "설정 조회",
        "description": "유저 설정 정보 조회",
        "tags": ["User"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserSettings" }
              }
            }
          }
        }
      },
      "put": {
        "summary": "설정 수정",
        "description": "유저 설정 정보 수정",
        "tags": ["User"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "notification_enabled": { "type": "boolean" },
                  "daily_reminder_time": { "type": "string" },
                  "preferred_voice_speed": { "type": "number" },
                  "show_romaji": { "type": "boolean" },
                  "show_translation": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공"
          }
        }
      }
    },
    "/api/sentences/today": {
      "get": {
        "summary": "오늘의 5문장 조회",
        "description": "유저의 레벨/관심사 기반 오늘의 5문장 반환 (첫 호출 시 생성)",
        "tags": ["Sentences"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DailySentencesResponse" }
              }
            }
          }
        }
      }
    },
    "/api/sentences/history": {
      "get": {
        "summary": "지난 학습 문장 조회",
        "description": "오늘을 제외한 과거 학습 문장들을 날짜별로 조회 (페이지네이션)",
        "tags": ["Sentences"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": { "type": "integer", "default": 10 }
          }
        ],
        "responses": {
          "200": {
            "description": "성공"
          }
        }
      }
    },
    "/api/learning/progress": {
      "post": {
        "summary": "학습 진행 상황 업데이트",
        "description": "문장별 이해/말하기/확인/암기 완료 상태 업데이트",
        "tags": ["Learning"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sentence_id", "daily_set_id"],
                "properties": {
                  "sentence_id": { "type": "integer" },
                  "daily_set_id": { "type": "integer" },
                  "understand": { "type": "boolean" },
                  "speak": { "type": "boolean" },
                  "confirm": { "type": "boolean" },
                  "memorized": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공"
          }
        }
      }
    },
    "/api/learning/quiz": {
      "post": {
        "summary": "퀴즈 제출",
        "description": "빈칸 채우기/문장 배열 퀴즈 정답 제출 및 검증",
        "tags": ["Learning"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sentence_id", "daily_set_id"],
                "properties": {
                  "sentence_id": { "type": "integer" },
                  "daily_set_id": { "type": "integer" },
                  "fill_blank_answer": { "type": "string" },
                  "ordering_answer": {
                    "type": "array",
                    "items": { "type": "integer" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sentence_id": { "type": "integer" },
                    "fill_blank_correct": { "type": "boolean" },
                    "ordering_correct": { "type": "boolean" },
                    "all_correct": { "type": "boolean" },
                    "memorized": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/learning/today": {
      "get": {
        "summary": "오늘의 학습 진행 상황 조회",
        "description": "오늘의 5문장 학습 진행 상황 조회",
        "tags": ["Learning"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "daily_set_id",
            "in": "query",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "성공"
          }
        }
      }
    },
    "/api/learning/history": {
      "get": {
        "summary": "학습 히스토리 조회",
        "description": "전체 학습 진행 히스토리 조회",
        "tags": ["Learning"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": { "type": "integer", "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "성공"
          }
        }
      }
    },
    "/api/flash/today": {
      "get": {
        "summary": "오늘의 Flash 문장 조회",
        "description": "오늘의 5문장을 Flash 카드 형식으로 조회. 상세 정보(phrase/tip/alt)가 없으면 자동 생성",
        "tags": ["Flash"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TodayFlashResponse" }
              }
            }
          }
        }
      }
    },
    "/api/flash/progress": {
      "post": {
        "summary": "Flash 진행 상황 업데이트",
        "description": "Flash 카드 학습 후 평가(bad/mid/good) 저장",
        "tags": ["Flash"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sentence_id", "grade"],
                "properties": {
                  "sentence_id": { "type": "integer" },
                  "grade": {
                    "type": "string",
                    "enum": ["bad", "mid", "good"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공"
          }
        }
      }
    },
    "/api/chat/session": {
      "post": {
        "summary": "대화 세션 생성",
        "description": "새로운 AI 대화 세션 생성",
        "tags": ["Chat"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["topic"],
                "properties": {
                  "topic": { "type": "string" },
                  "topic_detail": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "성공"
          }
        }
      }
    },
    "/api/chat/session/{id}": {
      "get": {
        "summary": "대화 세션 조회",
        "description": "대화 세션 상세 정보 조회 (메시지 포함)",
        "tags": ["Chat"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "성공"
          }
        }
      }
    },
    "/api/chat/session/{id}/end": {
      "post": {
        "summary": "대화 세션 종료",
        "description": "대화 세션을 수동으로 종료",
        "tags": ["Chat"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "성공"
          }
        }
      }
    },
    "/api/chat/session/{id}/message": {
      "post": {
        "summary": "메시지 전송 (SSE 스트리밍)",
        "description": "AI에게 메시지를 보내고 SSE로 스트리밍 응답 받기",
        "tags": ["Chat"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["message"],
                "properties": {
                  "message": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE 스트림",
            "content": {
              "text/event-stream": {}
            }
          }
        }
      }
    },
    "/api/chat/sessions": {
      "get": {
        "summary": "대화 세션 목록 조회",
        "description": "유저의 대화 세션 목록 조회",
        "tags": ["Chat"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": { "type": "integer", "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "성공"
          }
        }
      }
    },
    "/api/feedback/{sessionId}": {
      "get": {
        "summary": "대화 피드백 조회",
        "description": "세션 ID로 피드백 조회 (총점, 문법, 발음, 자연스러움 등)",
        "tags": ["Feedback"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "성공"
          }
        }
      }
    },
    "/api/stats/today": {
      "get": {
        "summary": "오늘의 통계 조회",
        "description": "오늘의 학습 요약 통계 (사용 문장 수, 학습 시간, streak 등)",
        "tags": ["Stats"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "성공"
          }
        }
      }
    },
    "/api/stats/categories": {
      "get": {
        "summary": "카테고리별 진행도 조회",
        "description": "카테고리별 학습 진행도 (애니, 게임, 음악, 영화, 드라마)",
        "tags": ["Stats"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "성공"
          }
        }
      }
    },
    "/api/stats/weekly": {
      "get": {
        "summary": "주간 통계 조회",
        "description": "최근 7일간의 학습 통계",
        "tags": ["Stats"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "성공"
          }
        }
      }
    },
    "/api/audio/{filename}": {
      "get": {
        "summary": "오디오 파일 프록시",
        "description": "Object Storage에서 오디오 파일을 가져와 반환",
        "tags": ["Audio"],
        "parameters": [
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "description": "파일명 (예: 1_5_20241214_123.wav)",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "오디오 파일",
            "content": {
              "audio/wav": {}
            }
          },
          "404": {
            "description": "파일 없음"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string" },
          "refresh_token": { "type": "string" },
          "expires_in": { "type": "integer" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "email": { "type": "string" },
          "name": { "type": "string" },
          "avatar_url": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "UserSettings": {
        "type": "object",
        "properties": {
          "notification_enabled": { "type": "boolean" },
          "daily_reminder_time": { "type": "string" },
          "preferred_voice_speed": { "type": "number" },
          "show_romaji": { "type": "boolean" },
          "show_translation": { "type": "boolean" }
        }
      },
      "DailySentencesResponse": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date" },
          "daily_set_id": { "type": "integer" },
          "sentences": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Sentence" }
          }
        }
      },
      "Sentence": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "sentence_key": { "type": "string" },
          "jp": { "type": "string", "description": "일본어 문장" },
          "kr": { "type": "string", "description": "한국어 번역" },
          "romaji": { "type": "string", "description": "로마자 표기" },
          "level": { "type": "integer", "description": "레벨 (3: N3, 4: N4, 5: N5)" },
          "category": { "type": "integer", "description": "카테고리 (1: 애니, 2: 게임, 3: 음악, 4: 영화, 5: 드라마)" },
          "audio_url": { "type": "string" },
          "words": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Word" }
          },
          "grammar": {
